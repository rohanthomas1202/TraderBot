# Phase 1: Paper Trading Environment
# Copy to .env and adjust as needed

# Database
POSTGRES_URL=postgres://trader:localdev@localhost:5432/autonomy?sslmode=disable

# NATS
NATS_URL=nats://localhost:4222

# Service addresses (for local non-Docker development)
MOCK_EXCHANGE_ADDR=localhost:50060
RISK_ENGINE_ADDR=localhost:50020
EXECUTION_ENGINE_ADDR=localhost:50040
WATCHDOG_ADDR=localhost:50055

# Risk engine
POLICY_FILE=./policies/paper.yaml
HMAC_KEY=phase1-paper-trading-hmac-key-not-for-production

# Execution engine
EXECUTION_MODE=paper
VENUE=mock

# Data ingestion
DATA_SOURCE=mock
PUBLISH_INTERVAL_MS=1000

# Kalshi API (Phase 11 — shadow mode, read-only)
# Set DATA_SOURCE=kalshi to use real Kalshi market data.
# Orders still go to the mock exchange (no real trading).
# KALSHI_API_KEY_ID=your_read_key_id
# KALSHI_API_KEY_SECRET=your_read_key_secret_hex
# KALSHI_API_BASE_URL=https://demo-api.kalshi.co/trade-api/v2
# KALSHI_MARKETS_CONFIG=./configs/kalshi_markets.yaml

# Strategy
STRATEGY=simple-momentum
SIGNAL_INTERVAL_SEC=5

# Mock exchange
FILL_DELAY_MS=100
FILL_PROBABILITY=0.5
PARTIAL_FILL_PROBABILITY=0.2
REJECTION_RATE=0.0

# Watchdog
HEARTBEAT_INTERVAL_SEC=10
HEARTBEAT_GRACE_MULTIPLE=3
MONITOR_INTERVAL_SEC=5

# General
LOG_LEVEL=debug
