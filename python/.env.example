# Kalshi API credentials (https://kalshi.com → Profile → Settings → API Keys)
KALSHI_API_KEY_ID=your_key_id
KALSHI_PRIVATE_KEY_PATH=/path/to/your/kalshi_private_key.pem

# Kalshi API base URL (matches Go services: KALSHI_API_BASE_URL)
# Uncomment to override the default production URL:
# KALSHI_API_BASE_URL=https://api.elections.kalshi.com/trade-api/v2

# PostgreSQL (matches docker-compose.yml defaults)
POSTGRES_URL=postgresql://trader:localdev@localhost:5432/autonomy?sslmode=disable
